# ==============================================================================
# REACHINBOX AI ONEBOX - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# API Key (for production - optional)
API_KEY=your-secure-api-key-here

# ------------------------------------------------------------------------------
# Feature Flags (Backwards Compatibility)
# ------------------------------------------------------------------------------
# Set to 'false' to disable features
ENABLE_ELASTICSEARCH=true
ENABLE_VECTOR_DB=true
ENABLE_AI_LABELING=true
ENABLE_WEBHOOKS=true
ENABLE_REALTIME=false  # SSE/WebSocket support (coming soon)

# ------------------------------------------------------------------------------
# IMAP Configuration - Account 1 (Required)
# ------------------------------------------------------------------------------
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For Outlook: Use App Password or OAuth2
IMAP_USER_1=your-email@gmail.com
IMAP_PASSWORD_1=your-16-char-app-password
IMAP_HOST_1=imap.gmail.com
IMAP_PORT_1=993

# ------------------------------------------------------------------------------
# IMAP Configuration - Account 2 (Optional)
# ------------------------------------------------------------------------------
IMAP_USER_2=another-email@gmail.com
IMAP_PASSWORD_2=your-16-char-app-password
IMAP_HOST_2=imap.gmail.com
IMAP_PORT_2=993

# ------------------------------------------------------------------------------
# Elasticsearch (Full-text Search & Indexing)
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------------------------------------------
# Qdrant Vector Database (RAG - Retrieval Augmented Generation)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# Google Gemini API (AI Categorization & Reply Generation)
# ------------------------------------------------------------------------------
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Rate limiting for Gemini API (calls per minute)
GEMINI_CALLS_PER_MINUTE=15

# ------------------------------------------------------------------------------
# Webhooks & Notifications
# ------------------------------------------------------------------------------
# Slack Incoming Webhook URL (for "Interested" lead notifications)
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Generic Webhook URL (webhook.site or your custom endpoint)
WEBHOOK_SITE_URL=https://webhook.site/your-unique-url

# Meeting Booking Link (included in AI-generated replies)
BOOKING_LINK=https://cal.com/example

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info
